prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libtcod
Description: A roguelike development library.
Version: @PACKAGE_VERSION@
Requires.private: @LIBTCOD_PKGCONFIG_REQUIRES_PRIVATE@
Cflags: -I${includedir}@LIBTCOD_PKGCONFIG_CFLAGS@
Libs: -L${libdir} @LIBTCOD_PKGCONFIG_LIBS@
